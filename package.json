{
  "name": "mcpees",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "OAuth-geschützte MCP-Server auf Cloudflare Workers plus die Übersichtsseite dazu.",
  "scripts": {
    "gen": "node scripts/gen-input-fields.mjs",
    "validate": "node scripts/validate-queries.mjs",
    "typecheck": "tsc --noEmit -p servers/hero/tsconfig.json && tsc --noEmit -p hub/tsconfig.json",
    "build:hero": "node scripts/bundle.mjs servers/hero/src/index.ts servers/hero/dist/worker.js",
    "build:hub": "node scripts/bundle.mjs hub/src/index.ts hub/dist/worker.js",
    "build": "npm run gen && npm run validate && npm run typecheck && npm run build:hero && npm run build:hub"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250109.0",
    "esbuild": "^0.25.0",
    "typescript": "^5.7.3"
  }
}
