{
  // Deployment läuft in dieser Umgebung über die Cloudflare-API (siehe scripts/deploy.mjs).
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "plausible-mcp",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-01",
  "workers_dev": true,
  "observability": { "enabled": true },
  "kv_namespaces": [
    {
      // Die Namespaces der Server werden bewusst NICHT geteilt: die abgelegten
      // Zugangsdaten gehören je einem Fremdsystem, und ein gemeinsamer Namespace
      // hieße, dass ein Token des einen Servers Schlüssel des anderen sehen könnte.
      "binding": "OAUTH_KV",
      "id": "b848915010204f9ab66b63af90f56bae"
    }
  ],
  "vars": {
    "HUB_URL": "https://mcp-hub.ksqsebastian.workers.dev"
  }
}
